APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:ulbYipXchE0QlkhZgbeqHI5bxDzb+LetNfsMtUudPD0=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://jobportal.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobportal
DB_USERNAME=root
DB_PASSWORD=Mysql@1234

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# secrets key của openai dùng tích hợp với chatgpt để tạo giới thiệu bản thân tự động
OPENAI_API_KEY=xxx

# secrets key của groq dùng để tích hợp với groqai để tạo giới thiệu bản thân tự động
GROQ_API_KEY=xxx

# secrets key của google dùng để tích hợp với đăng nhập bằng tài khoản google
GOOGLE_CLIENT_ID=xxx
GOOGLE_CLIENT_SECRET=xxx
# lưu ý phải trùng với redirect uri trong Google Console (domain thật hoặc ngrok để test)
GOOGLE_REDIRECT_URI=http://jobportal.local/auth/google/callback

# secrets key của github dùng để tích hợp với đăng nhập bằng tài khoản github
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
# lưu ý phải trùng với redirect uri trong Github (domain thật hoặc ngrok để test)
GITHUB_REDIRECT_URI=http://jobportal.local/login/github/callback
